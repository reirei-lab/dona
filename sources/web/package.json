{
  "name": "@dona/web-source",
  "version": "0.1.0",
  "private": true,
  "description": "Dona Web Adapter authentication boundary",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "generate:shiki": "node scripts/build-shiki.mjs",
    "prebuild": "npm run generate:shiki",
    "pretypecheck": "npm run generate:shiki",
    "pretest": "npm run generate:shiki",
    "pretest:browser": "npm run generate:shiki"
  },
  "dependencies": {
    "jose": "6.2.12",
    "marked": "18.1.0",
    "mermaid": "12.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "shiki": "4.5.0",
    "tsx": "4.20.5",
    "typescript": "7.0.2"
  }
}
