{
  "name": "@dona/dispatcher",
  "version": "0.1.0",
  "private": true,
  "description": "Durable, serial event dispatcher for Dona",
  "type": "module",
  "engines": {
    "node": ">=20.17.0"
  },
  "bin": {
    "dona-dispatcher": "dist/cli.js",
    "dona-dispatcher-mcp": "dist/mcp/index.js"
  },
  "scripts": {
    "build": "node scripts/build-security-native.mjs && tsc -p tsconfig.build.json && node scripts/build-job-result-validator.mjs",
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "test": "node ../scripts/run-scheduler-integration-gate.mjs && node test/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build-job-result-validator.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@simplewebauthn/server": "14.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.2",
    "moment-timezone": "0.5.48",
    "ulid": "^3.0.2",
    "ws": "8.21.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}
